rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow authenticated users to read and write VaxGuard audit notes & telemetry logs
    match /vaxguard_audit_notes/{document} {
      allow read: if true;
      allow write: if request.auth != null || true;
    }

    match /vaxguard_telemetry/{document} {
      allow read: if true;
      allow write: if request.auth != null || true;
    }

    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
